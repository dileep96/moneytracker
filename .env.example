# IBKR Flex Web Service
# 1. Generate a Flex Web Service token: Client Portal -> Performance & Reports -> Flex Queries -> Flex Web Service.
# 2. Build a Flex Query that includes: Open Positions, Cash Report, Trades, NAV, Net Stock Position Summary.
# 3. Copy the query ID and the token below.
IBKR_FLEX_TOKEN=
IBKR_FLEX_QUERY_ID=

# AED is pegged to USD; this rarely changes.
FX_AED_PER_USD=3.6725

# Optional: override the local SQLite path
DATA_DIR=./data
